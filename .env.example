# Copy to .env (same folder) and fill in. .env is gitignored: never commit it.

# Transport for NSW Open Data Hub API key ("API token").
# How to get one: docs/5_api_token_setup.md
TFNSW_API_KEY=replace-me

# Where snapshots and the poll manifest are written.
DATA_DIR=data
FEEDS_CONFIG=config/feeds.toml

# Bronze plan, checked 2026-11-16. Update once the 24-hour report
# confirms the real figure (docs/3_decisions.md D-004).
DAILY_QUOTA=60000
# Refuse to start if enabled feeds would use more than this share.
QUOTA_BUDGET_FRACTION=0.8
# TfNSW publishes 5 req/s, but bursts of 3 in ~1 s got 429 (D-013).
MAX_RPS=1

# Live alerts (docs/10_incidents.md O-01): an ntfy.sh topic that gets a
# push when a feed goes silent or the disk runs low. Pick a long random
# name, since anyone who knows it can read the alerts. Leave empty to
# only log to docs/reports/watch.log.
ALERT_NTFY_TOPIC=
